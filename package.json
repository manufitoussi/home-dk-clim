{
  "name": "home-daikin-ac",
  "scripts" : {
    "dev": "pnpm --filter home-dk-ac* dev",
    "build": "pnpm --filter home-dk-ac-svelte-app build && pnpm --filter home-dk-ac build:win",
    "format": "pnpm --filter home-dk-ac* format",
    "clean": "rm -rf ./node_modules ./pnpm-lock.yaml ./electron-app/node_modules ./electron-app/pnpm-lock.yaml ./svelte-app/node_modules ./svelte-app/pnpm-lock.yaml"
  }
}